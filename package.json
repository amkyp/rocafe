{
  "name": "rocafe-menu",
  "private": true,
  "description": "Ro Cafe menu: a static site. Nothing here is needed to host it; these tools only check and build it.",
  "type": "module",
  "scripts": {
    "release": "node tools/release.mjs",
    "check": "node tools/check.mjs",
    "lint": "eslint . && html-validate index.html"
  },
  "browserslist": [
    "ios_saf >= 12",
    "safari >= 12",
    "chrome >= 64",
    "and_chr >= 64",
    "android >= 64",
    "samsung >= 8",
    "firefox >= 68"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-compat": "^7.0.2",
    "globals": "^17.14.0",
    "html-validate": "^11.19.0",
    "postcss": "^8.5.32"
  }
}
